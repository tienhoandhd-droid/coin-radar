# Sao chép thành .env (quyền 600: chmod 600 .env), điền giá trị thật. KHÔNG commit .env.
# Cú pháp: mỗi dòng KEY=VALUE; dòng bắt đầu bằng # là chú thích; KHÔNG viết chú thích cuối dòng (sẽ thành một phần giá trị).
# Bot đọc tệp này trực tiếp (packages/bot/env.ts) — kể cả khi chạy bằng systemd.

# Chế độ bot: paper | demo | live (mặc định paper — chỉ paper cho tới khi qua lộ trình, xem docs/runbook-bot.md)
BOT_MODE=paper
# Ví USDT ban đầu của sàn giả lập (chỉ dùng khi chưa có data/bot/paper-state.json)
BOT_PAPER_BALANCE=1000
# Thư mục nhật ký + trạng thái (giữ trong data/bot/ để không lọt vào git)
BOT_DATA_DIR=data/bot
# Đối chiếu REST định kỳ (giây)
BOT_RECONCILE_EVERY_S=60
# Chỉ quét N hợp đồng thanh khoản cao nhất; bỏ trống = mọi hợp đồng
BOT_SCAN_LIMIT=

# Key Binance (chỉ demo/live)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# demo | live — loại key đang đặt ở trên (paper bỏ qua; live với BOT_MODE khác live → bot từ chối chạy)
BINANCE_ENV=demo
# Telegram (B6): token từ @BotFather, chat ID RIÊNG của bạn; bỏ trống cả hai = tắt Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
